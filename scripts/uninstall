#!/usr/bin/env bash
# Remove the user-level service and timer. Leaves the project, state/ and .env untouched.
set -uo pipefail

UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

systemctl --user disable --now danang-intern-finder.timer 2>/dev/null || true
systemctl --user stop danang-intern-finder.service 2>/dev/null || true
systemctl --user disable danang-intern-finder.service 2>/dev/null || true
rm -f "$UNIT_DIR/danang-intern-finder.timer" "$UNIT_DIR/danang-intern-finder.service"
systemctl --user daemon-reload 2>/dev/null || true
echo "Uninstalled. Project files, state/ and .env were left in place."
