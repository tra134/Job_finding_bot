#!/usr/bin/env bash
# Install the user-level systemd service and timer. No sudo.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

if [ ! -f "$ROOT/.env" ]; then
  echo "Refusing to install: $ROOT/.env does not exist. Copy .env.example to .env and fill it in." >&2
  exit 1
fi
mode="$(stat -c %a "$ROOT/.env")"
if [ "$mode" != "600" ]; then
  echo "Refusing to install: .env has mode $mode, expected 600. Run: chmod 600 $ROOT/.env" >&2
  exit 1
fi
if [ ! -x "$ROOT/.venv/bin/python" ]; then
  echo "Refusing to install: $ROOT/.venv not found. Create it and install requirements.txt first." >&2
  exit 1
fi
case "$ROOT" in
  *[[:space:]]*|*'|'*|*'&'*|*'\'*)
    echo "Refusing to install: project path contains unsupported characters." >&2
    exit 1;;
esac

mkdir -p "$UNIT_DIR"
for unit in danang-intern-finder.service danang-intern-finder.timer; do
  sed "s|@PROJECT_DIR@|$ROOT|g" "$ROOT/systemd/$unit" > "$UNIT_DIR/$unit"
  chmod 644 "$UNIT_DIR/$unit"
done

systemctl --user daemon-reload
systemctl --user enable --now danang-intern-finder.timer
echo "Installed. Check with: systemctl --user list-timers danang-intern-finder.timer"
